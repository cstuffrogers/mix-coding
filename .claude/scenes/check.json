{
  "scene_id": "check",
  "workflow": "check",
  "name": "引擎自检 + 自愈",
  "description": "引擎功能完整性检查：检测 dead actions / 场景声明但未实现的门禁 / 空转 handler，自动修复 gate-flags 数据文件",
  "trigger_keywords": ["自检", "check", "完整性检查", "引擎检查", "自愈"],
  "flow": [
    {
      "step": 0.5,
      "layer": "capability",
      "service": "MemoryService",
      "action": "recall",
      "params": {
        "mode": "full",
        "filters": {
          "type": ["check", "quality", "audit"]
        }
      },
      "description": "注入历史自检上下文和已知数据完整性问题"
    },
    {
      "step": 1,
      "layer": "capability",
      "service": "MetaCheckService",
      "action": "verify-handlers",
      "params": {},
      "description": "Handler 功能性验证：扫描 ACTION_REGISTRY + CE dispatch + handler 文件，检测空转桩"
    },
    {
      "step": 2,
      "layer": "capability",
      "service": "SelfCheckService",
      "action": "check-smoke",
      "params": {},
      "description": "Vitest 冒烟测试：dead action 检测 / handler smoke / await-safeExec 反模式 / scene JSON 完整性"
    },
    {
      "step": 4,
      "layer": "capability",
      "service": "SelfCheckService",
      "action": "check-gate-flags",
      "params": {},
      "description": "交叉对比场景声明的门禁名（checkGate.checks / gate）与引擎实现，点名引擎不认识的门禁"
    },
    {
      "step": 7,
      "layer": "capability",
      "service": "SelfCheckService",
      "action": "self-check-report",
      "params": {},
      "description": "生成结构化自检报告（发现数 + 修复数 + 遗留问题）"
    },
    {
      "step": 8,
      "layer": "capability",
      "service": "MemoryService",
      "action": "remember",
      "params": {
        "type": "check",
        "data": {
          "source": "check_workflow"
        }
      },
      "description": "保存自检结果到记忆（缺失项/修复项/遗留问题）"
    },
    {
      "step": 9,
      "layer": "capability",
      "service": "MemoryService",
      "action": "consolidate",
      "params": {},
      "description": "整理跨后端记忆一致性"
    },
    {
      "step": 10,
      "layer": "capability",
      "service": "NotificationService",
      "action": "notify",
      "params": {
        "type": "info",
        "message": "引擎自检完成"
      },
      "description": "通知自检结果（含修复统计与遗留问题）"
    }
  ],
  "status": "active"
}
