#!/usr/bin/env sh
# 提交门禁。任一步失败都必须挡住提交。
#
# 以前这里没有 set -e，收尾还是 `npm run scan:deadcode 2>/dev/null || true`：
# 最后一条命令永远返回 0 → 整段脚本的退出码恒为 0。实测：npx / npm 全部失败，
# hook 仍然 EXIT=0（第二十一轮那次提交就带着 3 个失败测试落地了）。
# 「跑过测试但没拦住」比不跑更糟：日志里全是绿的假象。
set -e

# 每步先自报名字：事后能从输出核出到底验过什么，而不是只有一串无从对应的日志。
echo '[pre-commit] 1/4 eslint（claude-scene 严格档，--max-warnings 0）'
(cd claude-scene && npx eslint . --max-warnings 0)

echo '[pre-commit] 2/4 vitest（全量测试）'
npm test

echo '[pre-commit] 3/4 死代码扫描（有死代码或扫描面塌了都非零退出）'
npm run scan:deadcode

# scenes-stats.json 是「场景步骤数」的唯一中间产物；它由 scan-scenes 写，但以前没有任何
# 门禁在提交前重跑它 —— 改了场景忘了重跑，stats 就悄悄过期，下游对齐全对着旧数字。
echo '[pre-commit] 4/4 scenes-stats.json 必须跟场景文件同步（陈旧产物不许提交）'
node scripts/scan-scenes.cjs > /dev/null
if ! git diff --quiet -- scripts/scenes-stats.json; then
  echo '❌ scripts/scenes-stats.json 不是最新（上面已按场景文件重写），请 git add 后重新提交'
  exit 1
fi

echo '[pre-commit] 全部通过'
